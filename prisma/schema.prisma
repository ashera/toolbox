// Prisma schema — defines your database tables.
// Docs: https://pris.ly/d/prisma-schema
//
// After changing a model here, run:  npm run db:push
// (that syncs your Postgres database to match this file)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Sample model used by the "Notes" tool ──────────────────────────────
// Each tool that needs to store data can add its own model below.
model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
}

// ── Used by the "FY26 Tax Return Estimator" tool ───────────────────────
// A single, shared row (id = "default") holding the income inputs, so they
// sync across devices instead of living in one browser's localStorage.
model TaxProfile {
  id               String   @id @default("default")
  salary           String   @default("")
  otherIncome      String   @default("")
  paygWithheld     String   @default("")
  hasHospitalCover Boolean  @default(true)
  hasHelpDebt      Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// One row per itemised work-related expense the user enters. The tool sums
// the claimable portion of these into the return's deductions.
model ExpenseItem {
  id             String   @id @default(cuid())
  description    String
  category       String // maps to a category id in eligibility.ts
  amount         Float // full amount paid, in dollars
  workUsePercent Int      @default(100) // 0–100; portion used for work
  reimbursed     Boolean  @default(false) // if true, nothing is claimable
  createdAt      DateTime @default(now())
}

// ── "Correspondence Tracker" tool ──────────────────────────────────────
// One row per item of correspondence sent (Aconex mail or Outlook email),
// so we can track whether the recipient has responded. Metadata only — we
// deliberately don't store message bodies.
model Correspondence {
  id               String    @id @default(cuid())
  source           String    @default("Email") // "Aconex" | "Email" | "Other"
  reference        String? // Aconex mail no., doc ref, etc.
  subject          String
  sentTo           String // contractor / client the item went to
  sentDate         DateTime
  responseNeededBy DateTime? // optional explicit due date
  status           String    @default("Awaiting") // "Awaiting" | "Responded" | "Closed"
  respondedDate    DateTime?
  link             String? // deep link back to the Aconex mail / Outlook thread
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, sentDate])
}
