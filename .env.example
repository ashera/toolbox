# Copy this file to ".env" and fill in your database connection string.
#
# Get a FREE Postgres database at https://neon.tech (takes ~2 minutes):
#   1. Sign up, create a project.
#   2. Copy the "Connection string" it shows you.
#   3. Paste it below as the value of DATABASE_URL, then run:  npm run db:push
#
# It will look something like:
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

DATABASE_URL=""
